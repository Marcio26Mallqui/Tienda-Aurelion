        <mxCell id="IOukQv6riQjzTOACoOwZ-24" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;li data-start=&quot;785&quot; data-end=&quot;842&quot;&gt;&lt;p data-start=&quot;787&quot; data-end=&quot;842&quot;&gt;Una &lt;strong data-start=&quot;791&quot; data-end=&quot;800&quot;&gt;venta&lt;/strong&gt; se paga con &lt;strong data-start=&quot;813&quot; data-end=&quot;839&quot;&gt;un único medio de pago&lt;/strong&gt;.&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;843&quot; data-end=&quot;909&quot;&gt;&lt;p data-start=&quot;845&quot; data-end=&quot;909&quot;&gt;Un &lt;strong data-start=&quot;848&quot; data-end=&quot;865&quot;&gt;medio de pago&lt;/strong&gt; puede estar asociado a &lt;strong data-start=&quot;889&quot; data-end=&quot;906&quot;&gt;muchas ventas&lt;/strong&gt;.&lt;/p&gt;&lt;/li&gt;" vertex="1">
